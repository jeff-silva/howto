<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="web.SearchBar" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_cp_searchview')]" position="before">
            <t t-if="this.env.searchModel.isCappProductionView and this.cappDepartments and this.cappDepartments.length > 0">
                <div class="me-2 d-flex align-items-center">
                    <select class="form-select bg-view text-body" style="width: 220px; border-radius: 6px; border: 1px solid #444;" 
                            t-on-change="this.onCappDepartmentChange">
                        <t t-foreach="this.cappDepartments" t-as="dept" t-key="dept.id">
                            <option t-att-value="dept.id" t-att-selected="dept.id === this.env.searchModel.cappSelectedDepartment" t-esc="dept.display_name" class="text-body bg-view"/>
                        </t>
                    </select>
                </div>
            </t>
        </xpath>
    </t>
</templates>
