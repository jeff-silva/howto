<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_capp_badge_template_form" model="ir.ui.view">
            <field name="name">capp.badge.template.form</field>
            <field name="model">capp.badge.template</field>
            <field name="arch" type="xml">
                <form string="Modelo de Crachá">
                    <sheet>
                        <widget name="web_ribbon" title="Inativo" bg_color="bg-danger" invisible="active"/>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Ex: Crachá PVC Funcionário..."/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="partner_id" placeholder="Selecione o Cliente"/>
                                <field name="department_id" placeholder="Ex: PVC Super" required="1"/>
                                <field name="product_id" invisible="1"/>
                                <field name="active" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Atributos Dinâmicos">
                                <field name="attribute_ids">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="label"/>
                                        <field name="field_type"/>
                                        <field name="required"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_capp_badge_template_list" model="ir.ui.view">
            <field name="name">capp.badge.template.list</field>
            <field name="model">capp.badge.template</field>
            <field name="arch" type="xml">
                <list string="Modelos">
                    <field name="name"/>
                    <field name="partner_id"/>
                </list>
            </field>
        </record>

        <record id="action_capp_badge_template" model="ir.actions.act_window">
            <field name="name">Modelos</field>
            <field name="res_model">capp.badge.template</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_capp_root" name="Gestão CAPP" sequence="10"/>
        <menuitem id="menu_capp_badge_template" name="Modelos" parent="menu_capp_root" action="action_capp_badge_template" sequence="20"/>
    </data>
</odoo>
