<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View: Form -->
    <record id="view_resumas_resume_form" model="ir.ui.view">
        <field name="name">resumas.resume.form</field>
        <field name="model">resumas.resume</field>
        <field name="arch" type="xml">
            <form string="Currículo">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,archived"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Ex: Desenvolvedor Front-end Pleno"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="language"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Editor">
                            <field name="json_resume" widget="json_resume_builder"/>
                        </page>
                        <page string="JSON Resume">
                            <field name="json_resume" widget="code" options="{'mode': 'json'}"/>
                        </page>
                        <page string="Preview">
                            <div class="o_horizontal_separator mb-3 text-primary" style="font-size: 16px;">
                                Pré-visualização e Download
                                <button string="Baixar PDF" type="object" name="action_download_pdf" class="btn btn-outline-primary ms-3" icon="fa-download"/>
                            </div>
                            <field name="preview_html" widget="html" nolabel="1" readonly="1" options="{'cssReadonly': false, 'sandboxPreview': true}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View: Tree/List -->
    <record id="view_resumas_resume_tree" model="ir.ui.view">
        <field name="name">resumas.resume.tree</field>
        <field name="model">resumas.resume</field>
        <field name="arch" type="xml">
            <list string="Currículos">
                <field name="name"/>
                <field name="user_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_resumas_resume" model="ir.actions.act_window">
        <field name="name">Currículos</field>
        <field name="res_model">resumas.resume</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crie o seu primeiro Currículo!
            </p>
        </field>
    </record>

    <!-- Menus -->
    <menuitem id="menu_resumas_root" name="Resumas" sequence="10"/>
    <menuitem id="menu_resumas_resume" name="Currículos" parent="menu_resumas_root" action="action_resumas_resume" sequence="10"/>

</odoo>
