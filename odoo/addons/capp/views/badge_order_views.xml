<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_capp_badge_order_form" model="ir.ui.view">
        <field name="name">capp.badge.order.form</field>
        <field name="model">capp.badge.order</field>
        <field name="arch" type="xml">
            <form string="Pedido de Crachá">
                <header>
                    <button name="action_confirm" string="Confirmar Pedido" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_produce" string="Enviar para Produção" type="object" class="oe_highlight" invisible="state != 'confirmed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,production,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sale_order" type="object" class="oe_stat_button" icon="fa-usd" invisible="not sale_order_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Pedido Venda</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="template_id"/>
                            <field name="quantity"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Preencher Dados" invisible="not template_id">
                            <field name="value_ids">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="attribute_id" column_invisible="1"/>
                                    <field name="attribute_type" column_invisible="1"/>
                                    <field name="attribute_name" readonly="1" force_save="1" decoration-bf="1"/>
                                    <field name="value_text" readonly="attribute_type == 'file'"/>
                                    <field name="value_file" readonly="attribute_type != 'file'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_capp_badge_order_list" model="ir.ui.view">
        <field name="name">capp.badge.order.list</field>
        <field name="model">capp.badge.order</field>
        <field name="arch" type="xml">
            <list string="Pedidos de Crachá">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="template_id"/>
                <field name="stage_id" widget="badge" decoration-info="1" optional="show"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'confirmed'" decoration-primary="state == 'production'" decoration-success="state == 'done'" decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_capp_badge_order_search" model="ir.ui.view">
        <field name="name">capp.badge.order.search</field>
        <field name="model">capp.badge.order</field>
        <field name="arch" type="xml">
            <search string="Pesquisar Pedidos">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="department_id"/>
                <separator/>
                <group>
                    <filter string="Etapa" name="group_by_stage" context="{'group_by':'stage_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_capp_badge_order_production_search" model="ir.ui.view">
        <field name="name">capp.badge.order.production.search</field>
        <field name="model">capp.badge.order</field>
        <field name="inherit_id" ref="view_capp_badge_order_search"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <!-- Searchpanel removido para usar os filtros normais -->
            </xpath>
        </field>
    </record>

    <record id="capp_badge_order_card_view" model="ir.ui.view">
        <field name="name">capp.badge.order.card</field>
        <field name="model">capp.badge.order</field>
        <field name="arch" type="xml">
            <card>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="template_id"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex mb-1 align-items-center justify-content-between">
                            <field name="name" class="fw-bolder fs-6 ms-1"/>
                        </div>
                        <div class="mt-2">
                            <span><field name="partner_id"/></span>
                        </div>
                        <div>
                            <small class="text-muted"><field name="template_id"/></small>
                        </div>
                    </t>
                </templates>
            </card>
        </field>
    </record>

    <record id="view_capp_badge_order_kanban" model="ir.ui.view">
        <field name="name">capp.badge.order.kanban</field>
        <field name="model">capp.badge.order</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" card_id="%(capp_badge_order_card_view)d" default_group_by="stage_id" create="0">
            </kanban>
        </field>
    </record>

    <record id="action_capp_badge_order" model="ir.actions.act_window">
        <field name="name">Pedidos</field>
        <field name="res_model">capp.badge.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '!=', 'production')]</field>
        <field name="search_view_id" ref="view_capp_badge_order_search"/>
    </record>

    <record id="action_capp_production_window" model="ir.actions.act_window">
        <field name="name">Produção</field>
        <field name="res_model">capp.badge.order</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('state', '=', 'production')]</field>
        <field name="context">{'default_state': 'production', 'capp_production_view': True}</field>
        <field name="search_view_id" ref="view_capp_badge_order_production_search"/>
    </record>

    <record id="action_capp_production_server" model="ir.actions.server">
        <field name="name">Produção</field>
        <field name="model_id" ref="capp.model_capp_badge_order"/>
        <field name="state">code</field>
        <field name="code">
action = env["ir.actions.act_window"]._for_xml_id("capp.action_capp_production_window")
ctx = {'default_state': 'production', 'capp_production_view': True}
action['context'] = ctx
        </field>
    </record>

    <menuitem id="menu_capp_badge_order" name="Pedidos" parent="menu_capp_root" action="action_capp_badge_order" sequence="40"/>
    <menuitem id="menu_capp_production" name="Produção" parent="menu_capp_root" action="action_capp_production_server" sequence="50"/>
</odoo>
